{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "license": "MIT",
  "default-features": [
    {
      "name": "copyleft",
      "platform": "windows | linux | osx | android"
    }
  ],
  "dependencies": [
    {
      "name": "bit7z",
      "platform": "windows | linux | osx"
    },
    {
      "name": "boost-locale",
      "platform": "windows | linux | osx"
    },
    {
      "name": "boost-log",
      "platform": "windows | linux | osx"
    },
    {
      "name": "boost-dll",
      "platform": "windows | linux | osx"
    },
    "boost-multiprecision",
    {
      "name": "boost-nowide",
      "platform": "windows | linux | osx"
    },
    "boost-date-time",
    {
      "name": "fontconfig",
      "platform": "windows | linux | osx"
    },
    "boost-property-tree",
    "boost-test",
    "boost-units",
    "boost-uuid",
    "boost-pfr",
    "boost-graph",
    "clipper2",
    "libjpeg-turbo",
    "libpng",
    {
      "name": "opencv",
      "platform": "windows | linux | osx | android"
    },
    "eigen3",
    {
      "name": "libigl",
      "platform": "!windows & !linux & !osx & !android"
    },
    "freetype",
    "miniz",
    {
      "name": "openvdb",
      "platform": "windows | linux | osx"
    },
    "protobuf",
    "rapidjson",
    "tinyxml2",
    "yaml-cpp",
    "lua",
    "openssl",
    {
      "name": "sqlpp11",
      "features": [
        "sqlite3",
        "mysql",
        "postgresql"
      ],
      "platform": "windows | linux | osx "
    },
    {
      "name": "sqlpp11",
      "features": [
        "sqlite3"
      ],
      "platform": "android | ios"
    },
    {
      "name": "vcpkg-pkgconfig-get-modules",
      "platform": "windows | linux | osx "
    },
    "magic-enum"
  ],
  "features": {
    "copyleft": {
      "description": "Build with copyleft kernels (CGAL GPL-3.0-or-later, OpenCascade LGPL-2.1-only). Enabling this feature switches the project license from MIT to GPL-3.0-or-later.",
      "license": "GPL-3.0-or-later",
      "dependencies": [
        {
          "name": "cgal",
          "platform": "windows | linux | osx | android"
        },
        {
          "name": "libigl",
          "features": [
            "cgal"
          ],
          "platform": "windows | linux | osx | android"
        },
        {
          "name": "opencascade",
          "platform": "windows | linux | osx "
        }
      ]
    }
  }
}
